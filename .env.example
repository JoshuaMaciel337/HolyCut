# -----------------------------------------------
# HolyCut — variáveis de ambiente
# Copie para .env e preencha. Nunca commite o .env.
# -----------------------------------------------

# Banco
DATABASE_NAME=holycut
# Só para rodar API e worker fora do Docker. Dentro do Docker o compose já aponta para o serviço mongo.
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# Sessão — gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
SESSAO_DIAS=7
# true quando o site estiver em HTTPS (túnel da Cloudflare)
COOKIE_SEGURO=false

# IA: "simulado" nesta máquina de desenvolvimento, "real" no Nitro 5
MODO_IA=simulado

# Onde ficam os vídeos enviados e os arquivos gerados. Vídeos de culto são grandes:
# aponte para o disco com mais espaço (ex.: D:/HolyCut/armazenamento).
PASTA_ARMAZENAMENTO_HOST=./armazenamento
# Maior arquivo aceito, e quanto espaço o disco precisa manter livre depois do envio
UPLOAD_MAX_GB=20
ESPACO_MINIMO_LIVRE_GB=2

# Portas neste computador. Troque se já houver outro serviço usando alguma delas
# (por exemplo, um MongoDB local na 27017).
MONGO_PORTA=27017
API_PORTA=8000
WEB_PORTA=3000

# Backup diário do Mongo
BACKUP_HORA=03:00
BACKUP_RETENCAO_DIAS=14
# Pasta do computador onde os backups ficam (HD externo, Google Drive etc.)
PASTA_BACKUP_HOST=./backups

# Cloudflare Tunnel fixo (perfil "tunel"). Token criado no painel Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# Pixabay: busca de foto e vídeo de apoio. A chave fica neste arquivo, nunca no Git nem no site.
# Na documentação logada (pixabay.com/api/docs) ela aparece no parâmetro key.
PIXABAY_API_KEY=
